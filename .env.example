# OKX API Credentials (get from https://www.okx.com/web3/build/dev-portal)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Wallet (deployer + demo agent)
PRIVATE_KEY=

# IPFS (get from https://app.pinata.cloud)
PINATA_JWT=

# Network
X_LAYER_RPC=https://rpc.xlayer.tech

# Contract (set after deploy)
LINEAGE_CONTRACT=

# Server
PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Uniswap (optional — X Layer uses OKX liquidity data)
UNISWAP_API_KEY=

# OKX base URL
OKX_BASE_URL=https://web3.okx.com

# IPFS gateway
IPFS_GATEWAY=https://gateway.pinata.cloud

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# x402 (set true — OKX facilitator not yet live)
X402_PRICE=0.01
X402_DEMO_MODE=true

# LLM (for AI-powered agent reasoning)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Agent
AGENT_CONFIDENCE_FLOOR=0.6
LOG_LEVEL=info
